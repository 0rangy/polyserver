App.AdminMethod=STDIO
App.ApplicationReadyMode=Immediate
App.BaseDirectory=./polyserver/
App.CommandLineArgs=--address {{$ApplicationIPBinding}} {{$FormattedArgs}}
App.CommandLineParameterDelimiter= 
App.CommandLineParameterFormat=--{0} {1}
App.DisplayName=Polyserver
App.ExecutableLinux=polyserver
App.ExecutableWin=polyserver.exe
App.ExitMethod=Kill
App.ExitString=stop
App.HasReadableConsole=true
App.HasWritableConsole=true
App.RapidStartup=false
App.RootDir=./polyserver/
App.UpdateSource=Multi
App.UpdateSources=[{"UpdateStageName": "GitHub Release Download","UpdateSourcePlatform": "All", "UpdateSource": "GithubRelease", "UpdateSourceData": "polytrackmods/polyserver-go"}]
App.WorkingDir=
Console.AppReadyRegex=^Server started with PID  (?<pid>.+?)$
Console.ThrowawayMessageRegex=^(WARNING|ERROR): Shader.+$
Console.UserChatRegex=^(?<username>.+?): (?<message>.+)$
Console.UserJoinRegex=^User is joining:  (?<username>.+?)$
Console.UserLeaveRegex=^Removing player (?<username>.+?)$
Meta.Author=Jakob Wallner
Meta.ConfigManifest=polyserverconfig.json
Meta.ConfigRoot=polyserver.kvp
Meta.Description=A go-based web server for the browser game PolyTrack by Kodub
Meta.DisplayImageSource=url:
Meta.DisplayName=Polyserver
Meta.EndpointURIFormat=
Meta.OS=3
Meta.URL=https://github.com/polytrackmods/polyserver-go