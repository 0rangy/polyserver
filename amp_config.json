{
    "Meta_DisplayName": "Polyserver",
    "Meta_Description": "A go-based web server for the browser game PolyTrack by Kodub",
    "Meta_Author": "Jakob Wallner",
    "Meta_URL": "https://github.com/polytrackmods/polyserver-go",
    "_SupportsWindows": true,
    "_SupportsLinux": true,
    "App_AdminMethod": "STDIO",
    "App_HasReadableConsole": true,
    "App_HasWritableConsole": true,
    "App_DisplayName": "Polyserver",
    "App_CommandLineArgs": "--address {{$ApplicationIPBinding}} {{$FormattedArgs}}",
    "App_CommandLineParameterFormat": "--{0} {1}",
    "App_CommandLineParameterDelimiter": " ",
    "App_RapidStartup": "false",
    "App_ApplicationReadyMode": "Immediate",
    "App_ExitMethod": "Kill",
    "App_ExitString": "stop",
    "Console_ThrowawayMessageRegex": "^(WARNING|ERROR): Shader.+$",
    "Console_AppReadyRegex": "^Server started with PID  (?<pid>.+?)$",
    "Console_UserJoinRegex": "^User is joining:  (?<username>.+?)$",
    "Console_UserLeaveRegex": "^Removing player (?<username>.+?)$",
    "Console_UserChatRegex": "^(?<username>.+?): (?<message>.+)$",
    "_PortMappings": [],
    "_UpdateSourceType": "16",
    "_UpdateSourceURL": "",
    "_UpdateSourceGitRepo": "polytrackmods/polyserver-go",
    "_UpdateSourceUnzip": false,
    "_DisplayImageSource": "",
    "_SteamServerAppID": "",
    "_SteamClientAppID": "",
    "_WinExecutableName": "polyserver.exe",
    "_LinuxExecutableName": "polyserver",
    "_AppSettings": [
        {
            "DisplayName": "Web frontend Port",
            "Category": "Port",
            "Description": " the port the server management dashboard binds to",
            "Keywords": "Port",
            "FieldName": "port",
            "InputType": "number",
            "IsFlagArgument": false,
            "ParamFieldName": "port",
            "IncludeInCommandLine": true,
            "DefaultValue": "8080",
            "_CheckedValue": "true",
            "_UncheckedValue": "false",
            "EnumValues": {}
        },
        {
            "DisplayName": "Control server port",
            "Category": "Port",
            "Description": "The port that the control server binds to",
            "Keywords": "Port",
            "FieldName": "control-port",
            "InputType": "number",
            "IsFlagArgument": false,
            "ParamFieldName": "control-port",
            "IncludeInCommandLine": true,
            "DefaultValue": "9090",
            "_CheckedValue": "true",
            "_UncheckedValue": "false",
            "EnumValues": {}
        }
    ],
    "Meta_OS": 3,
    "Meta_ConfigManifest": "polyserverconfig.json",
    "Meta_ConfigRoot": "polyserver.kvp",
    "Meta_DisplayImageSource": "url:",
    "App_RootDir": "./polyserver/",
    "App_BaseDirectory": "./polyserver/",
    "App_WorkingDir": "",
    "App_ExecutableWin": "polyserver.exe",
    "App_ExecutableLinux": "polyserver",
